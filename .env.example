# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get a key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-2.5-flash-lite
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# ── Vector store ──────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=./data/faiss_index

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
